// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
    id String @id @default(cuid(2))
    clerkId String @unique
    email String @unique
    name String
    profileImg String?
    
    createdAt DateTime @default(now())
    updatedAt temporal.updatedAt()
    
    @@index([clerkId])
}